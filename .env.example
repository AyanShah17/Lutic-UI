# Optional HTTPS endpoint accepting JSON contact messages.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Set if a reverse proxy changes the request origin.
CONTACT_ALLOWED_ORIGIN=

# Actual verified public HTTPS origin, no path or query. Required for indexing.
SITE_URL=
# Set 1 to keep production out of search.
SEO_NOINDEX=0
# Optional Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=
